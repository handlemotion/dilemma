{
  "name": "dilemma",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dilemma/app dev",
    "build": "pnpm --filter @dilemma/app build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "fetch-assets": "node scripts/fetch-sample-assets.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "install-app": "pnpm --filter @dilemma/app install-app"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
